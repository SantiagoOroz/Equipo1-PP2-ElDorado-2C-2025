# --- Configuración de Conexión ---
# URL de tu servidor LM Studio
LM_STUDIO_URL="http://localhost:1234/v1/chat/completions"

# Credenciales de la Wiki de El Dorado
WIKI_BASE_URL="https://objetivos.eldoradosrl.ar/wiki"
# Requerido para integrar la wiki. Rellenar credenciales
WIKI_USERNAME="" 
WIKI_PASSWORD=""

# --- Configuración de Directorios ---
# PDFs que vienen con el proyecto
PDF_DIR="data/pdfs" 
# PDFs que suben los usuarios
UPLOAD_DIR="data/uploads" 
# Dónde se guarda la base de datos vectorial
CHROMA_DIR="data/chroma_db" 

# --- Configuración de Modelos RAG ---
# Modelo para crear los embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
# Modelo a usar en LM Studio (asegúrate que coincida)
LLM_MODEL_NAME="Meta-Llama-3-8B-Instruct"

# --- Configuración de Indexación (Chunking) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Configuración de Consulta RAG ---
# Cuántos chunks recuperar, tanto pdfs como de la wiki. Habria que cambiarle el nombre.
PDF_TOP_K=6
# Cuántos resultados de la Wiki recuperar # Obsoleto
WIKI_TOP_K=6
# Cuántos caracteres mostrar del extracto de la fuente
EXTRACT_LENGTH=0
