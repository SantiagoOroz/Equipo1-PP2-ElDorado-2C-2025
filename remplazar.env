# ===============================================
# === CONFIGURACIÓN GENERAL DEL PROYECTO RAG ===
# ===============================================

# --- DIRECTORIOS ---
# Ruta a la carpeta que contiene los archivos PDF a indexar.
PDF_DIR="data/raw/Antecedentes PDF"

# Directorio donde se guardará la base de datos vectorial persistente.
CHROMA_DIR="data/processed/chroma_db"

# Ruta COMPLETA al archivo del modelo Llama en formato GGUF.
# ‼️ IMPORTANTE: Ajusta esta ruta a tu sistema. Usa barras inclinadas (/)
LLAMA_MODEL_PATH="C:/Users/capod/.lmstudio/models/lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf"

# --- MODELOS ---
# Nombre del modelo de embeddings que se descargará de Hugging Face.
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# --- CONFIGURACIÓN DE CONSULTA RAG ---
# Cantidad de caracteres a mostrar del chunk de texto recuperado.
EXTRACT_LENGTH=300

# --- AJUSTES DE RENDIMIENTO DE LLAMA-CPP ---
# Número de capas a descargar en la GPU (0 para usar solo CPU).
N_GPU_LAYERS=0

# Tamaño del lote para el procesamiento.
N_BATCH=1024

# Número de hilos/núcleos de CPU a utilizar.
N_THREADS=12

# Ventana de contexto máxima del modelo.
CONTEXT_WINDOW=4096